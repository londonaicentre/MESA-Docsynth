# API Keys for LLM providers
llm__gemini__api_key=your_api_key_here
llm__anthropic__api_key=your_api_key_here

# Local LLM endpoint (for OpenAI-compatible servers like LM Studio, Ollama, etc.)
llm__local__base_url=http://localhost:1234/v1
llm__local__model=local-model

# Optional: Bearer token if the local server requires authentication
# (e.g. LM Studio with auth on)
llm__local__api_key=not-needed